# Example environment file
# Copy to .env and set your values

# Discord
DISCORD_TOKEN=

# Validation
# When true (default), actions parsed from player commands must pass JSON Schema
SCHEMA_STRICT=true

# AI (Groq). Without a key the game runs on its fallbacks: typed orders use
# the fixed grammar and battle reports use plain text.
GROQ_API_KEY=
# Optional: the Groq model to use (defaults to llama-3.1-8b-instant)
GROQ_MODEL=
# Optional: append one JSON line per AI call (tokens, estimated cost)
AI_COST_LOG=
# Optional: save every AI reply to this folder as a test fixture
AI_RECORD_DIR=
