# Example environment file
# Copy to .env and set your values

# The web app (npm run web)
# PORT=3000
# COHORT_DATA_DIR=data/web
# Optional: save to Postgres instead of files (a postgres:// connection
# string; the host gives it). Set it in the host's settings, never here.
DATABASE_URL=

# AI (Groq). Without a key the game runs on its fallbacks: typed orders use
# the fixed grammar and battle reports use plain text.
GROQ_API_KEY=
# Optional: the Groq model to use (defaults to openai/gpt-oss-20b; see docs/ai/MODELS.md)
GROQ_MODEL=
# Optional: append one JSON line per AI call (tokens, estimated cost)
AI_COST_LOG=
# Optional: save every AI reply to this folder as a test fixture
AI_RECORD_DIR=

# Discord (docs/HOSTING.md, "Connecting Discord"). Optional: with none set
# there is no sign-in and nothing is sent. Set them in the host's settings,
# never here.
PUBLIC_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_BATTLES_CHANNEL_ID=
