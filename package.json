{
  "name": "cohort-discord-bot",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test:core": "node src/tests/core/coreEngine.test.js",
    "test": "node --test \"src/phase2-combat/tests/**/*.test.js\" \"src/phase3-movement/tests/**/*.test.js\" \"src/phase4-integration/tests/**/*.test.js\" \"src/phase5-orchestration/tests/**/*.test.js\" \"src/phase6-veterans/tests/**/*.test.js\"",
    "replay": "node scripts/replayBattle.js",
    "test:phase2": "node --test \"src/phase2-combat/tests/**/*.test.js\"",
    "sim": "node src/phase2-combat/run.js",
    "test:legacy": "node src/tests/core/coreEngine.test.js",
    "balance": "node src/phase2-combat/balance/run-balance.js",
    "test:phase3": "node --test \"src/phase3-movement/tests/**/*.test.js\"",
    "test:phase4": "node --test \"src/phase4-integration/tests/**/*.test.js\"",
    "test:phase5": "node --test \"src/phase5-orchestration/tests/**/*.test.js\"",
    "test:phase6": "node --test \"src/phase6-veterans/tests/**/*.test.js\""
  },
  "keywords": [
    "discord",
    "strategy",
    "ancient",
    "warfare"
  ],
  "author": "",
  "license": "ISC",
  "description": "Ancient warfare strategy game for Discord",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.1",
    "@anthropic-ai/sdk": "^0.24.2",
    "ajv": "^8.17.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "grog": "^0.0.1",
    "groq-sdk": "^0.5.0",
    "lodash": "^4.17.21",
    "openai": "^4.52.0",
    "papaparse": "^5.4.1",
    "sequelize": "^6.35.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "install": "^0.13.0",
    "nodemon": "^3.0.2"
  }
}
