{
  "name": "cohort-discord-bot",
  "version": "1.0.0",
  "main": "src/web/server.js",
  "scripts": {
    "start": "node src/web/server.js",
    "dev": "node --watch src/web/server.js",
    "test": "node --test \"src/engine/**/*.test.js\" \"src/harness/**/*.test.js\" \"src/adapters/**/*.test.js\" \"src/llm/**/*.test.js\" \"src/interpreter/**/*.test.js\" \"src/narrator/**/*.test.js\" \"src/web/**/*.test.js\"",
    "test:engine": "node --test \"src/engine/**/*.test.js\"",
    "test:harness": "node --test \"src/harness/**/*.test.js\"",
    "sim": "node src/harness/run.js",
    "balance": "node src/harness/balance/run-balance.js",
    "play": "node src/adapters/hotseat/play.js",
    "officers": "node src/harness/officer-fates.js",
    "soak": "node src/harness/soak.js",
    "web": "node src/web/server.js",
    "ai:bench": "node src/harness/ai-bench.js",
    "test:browser": "node --test src/web/browser/battle.browser.js"
  },
  "keywords": [
    "strategy",
    "ancient",
    "warfare",
    "wargame"
  ],
  "author": "",
  "license": "ISC",
  "description": "Cohort: an ancient warfare battle game. A pure engine, a web app (the Command Tent) and a hotseat CLI.",
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "eslint": "^9.38.0"
  }
}
